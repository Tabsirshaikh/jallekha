# Preserve downloaded source bytes exactly on every operating system.
data/raw/** -text

# Keep generated metadata and source code consistent across platforms.
*.csv text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf