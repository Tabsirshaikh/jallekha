# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Load it with: .venv\Scripts\python -m uvicorn app.main:app --app-dir backend --env-file .env
# An empty value means "use the default".

# SQLAlchemy database URL. Default: SQLite file jallekha.db in the repository root.
DATABASE_URL=

# Secret for the tamper-evident ledger HMAC (F18). Required before ledger entries are written.
# For local use, any long random string works. Never reuse a production key.
LEDGER_HMAC_KEY=
# Id of LEDGER_HMAC_KEY, stored with every ledger entry (key rotation). Default: k1.
LEDGER_KEY_ID=
# Retired ledger keys, so older entries still verify after a rotation: id:key,id:key
LEDGER_OLD_HMAC_KEYS=

# OSRM routing server, e.g. http://localhost:5000 (routing, P2). Empty = offline estimate.
OSRM_URL=

# Speech-to-text mode (F14): fallback (store voice note for a human) or indicconformer.
ASR_MODE=fallback

# SMS provider (F12, F14, F15): fake (log only, for tests and demo).
SMS_PROVIDER=fake

# Secret for hashing phone numbers at intake (F14). Raw numbers are never stored.
# Required before reports with a phone number are accepted. Any long random string.
PHONE_HASH_KEY=

# Folder for stored voice notes (F14). Default: uploads/audio in the repository (git-ignored).
INTAKE_AUDIO_DIR=
