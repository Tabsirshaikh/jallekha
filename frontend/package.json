{
  "name": "jallekha-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "i18n:export": "node scripts/exportTranslations.mjs",
    "i18n:check": "node scripts/exportTranslations.mjs --check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
